# PrimeTrack
PRIMETRACK_URL=https://primetrack.pro
# API key of the PrimeTraff advertiser with scope "partners:write"
PRIMETRACK_API_KEY=

# Bot @primegeneratebot (token from @BotFather)
BOT_TOKEN=

# Manager account @brafrez (api_id / api_hash from https://my.telegram.org → API development tools)
TG_API_ID=
TG_API_HASH=
# Filled in by: npm run login
TG_SESSION=

# Only partners who joined after this moment are onboarded (ISO date, UTC)
START_AT=

# Optional
POLL_SECONDS=60
REMINDER_HOURS=24
# Wait after the partner's last message before handling the answer (he may send several)
ANSWER_SETTLE_SECONDS=45
# Delay between activation and chat creation
CHAT_DELAY_SECONDS=90
